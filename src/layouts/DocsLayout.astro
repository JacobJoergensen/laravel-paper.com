---
import ArrowUpRightIcon from "../components/icons/ArrowUpRightIcon.astro";
import Nav from "../components/Nav.astro";
import { getDocsNav, groupForSlug, siblingsForSlug } from "../config/DocsNav";
import Layout from "./Layout.astro";

import type { MarkdownHeading } from "astro";

interface Props {
    title: string;
    description: string;
    currentId: string;
    headings: MarkdownHeading[];
}

const { title, description, currentId, headings } = Astro.props;

const toc = headings.filter((h) => h.depth === 2);

const docsNav = await getDocsNav();
const group = groupForSlug(docsNav, currentId) ?? "Introduction";
const { prev, next } = siblingsForSlug(docsNav, currentId);

const OVERVIEW_ID = "overview";

const navLink = "rounded-md border-l-2 border-l-transparent px-2.5 py-1.25 text-[13.5px] no-underline transition hover:text-ink";

const paginationLink = "flex-1 rounded-[10px] border border-hairline bg-canvas-raised px-4.25 py-3.5 no-underline transition hover:border-hairline-strong";

const editUrl = currentId === "changelog"
    ? "https://github.com/jacobjoergensen/laravel-paper/edit/main/CHANGELOG.md"
    : `https://github.com/jacobjoergensen/laravel-paper.com/edit/main/src/content/docs/${currentId}.mdx`;
---

<Layout title={`${title} - Laravel Paper docs`} description={description}>
    <Nav section={currentId === "changelog" ? "changelog" : "docs"} currentId={currentId} />

    <div class="docs-layout mx-auto grid max-w-wide grid-cols-[248px_minmax(0,1fr)] items-start gap-14 px-(--gutter) max-[900px]:grid-cols-1">
        <aside class="sticky top-(--nav-height) h-[calc(100vh-var(--nav-height))] overflow-y-auto py-9 pr-3 max-[900px]:hidden">
            <docs-toc>
                <nav aria-label="Documentation">
                    {
                        docsNav.map((g) => (
                            <div class="mb-5.5">
                                <div class="mb-2.5 font-mono text-[10.5px] uppercase tracking-widest text-ink-faint">
                                    {g.group}
                                </div>
                                <div class="flex flex-col gap-px">
                                    {g.items.map((it) => (
                                        <Fragment>
                                            <a
                                                href={it.slug ? `/docs/${it.slug}` : (it.href ?? "#")}
                                                class:list={[
                                                    navLink,
                                                    it.slug === currentId
                                                        ? "border-l-accent bg-canvas-raised font-medium text-ink"
                                                        : "text-ink-muted",
                                                ]}
                                            >
                                                {it.title}
                                            </a>

                                            {it.slug === currentId && toc.length > 0 && (
                                                <div class="my-1 ml-3.25 flex flex-col gap-px border-l border-hairline pl-2">
                                                    <a
                                                        href={`#${OVERVIEW_ID}`}
                                                        data-toc-link={OVERVIEW_ID}
                                                        class="rounded-md py-1 pl-2 pr-1 text-[12.5px] leading-snug text-ink-muted no-underline transition hover:text-ink aria-[current=true]:font-medium aria-[current=true]:text-accent"
                                                    >
                                                        Overview
                                                    </a>
                                                    {toc.map((h) => (
                                                        <a
                                                            href={`#${h.slug}`}
                                                            data-toc-link={h.slug}
                                                            class="rounded-md py-1 pl-2 pr-1 text-[12.5px] leading-snug text-ink-muted no-underline transition hover:text-ink aria-[current=true]:font-medium aria-[current=true]:text-accent"
                                                        >
                                                            {h.text}
                                                        </a>
                                                    ))}
                                                </div>
                                            )}
                                        </Fragment>
                                    ))}
                                </div>
                            </div>
                        ))
                    }
                </nav>
            </docs-toc>
        </aside>

        <main
            id="main"
            tabindex="-1"
            class="docs-main min-w-0 scroll-mt-20 pb-28 pt-11 focus:outline-none max-[900px]:pt-8"
        >
            <article class="docs-article max-w-195">
                <div class="mb-5.5 flex flex-wrap items-center justify-between gap-4">
                    <div class="font-mono text-[11.5px] uppercase tracking-[0.06em] text-ink-faint">
                        {group}&nbsp;&nbsp;/&nbsp;&nbsp;<span class="text-accent">{title}</span>
                    </div>
                    <a
                        href={editUrl}
                        class="flex items-center gap-2 text-[12.5px] text-ink-muted no-underline transition hover:text-ink"
                        target="_blank"
                        rel="noopener"
                    >
                        <ArrowUpRightIcon size={13} />
                        Edit this page
                    </a>
                </div>

                <h1
                    id={OVERVIEW_ID}
                    class="mb-4 mt-0 scroll-mt-20 font-display text-[clamp(34px,5vw,44px)] font-medium leading-[1.08] tracking-[-0.022em]"
                >
                    {title}
                </h1>
                <p class="mb-9 mt-0 text-[17px] leading-[1.65] text-ink-muted">{description}</p>

                <div class="prose">
                    <slot />
                </div>

                {
                    (prev ?? next) && (
                        <nav
                            aria-label="Page navigation"
                            class="mt-14 flex gap-3 border-t border-hairline pt-8 max-[560px]:flex-col"
                        >
                            {prev && (
                                <a href={`/docs/${prev.slug}`} class={paginationLink}>
                                    <span class="mb-1.5 block font-mono text-[10.5px] uppercase tracking-widest text-ink-faint">
                                        Previous
                                    </span>
                                    <span class="block text-[14.5px] font-semibold text-ink">
                                        <span class="text-accent" aria-hidden="true">
                                            &#8592;&nbsp;
                                        </span>
                                        {prev.title}
                                    </span>
                                </a>
                            )}
                            {next && (
                                <a
                                    href={`/docs/${next.slug}`}
                                    class:list={[paginationLink, "text-right"]}
                                >
                                    <span class="mb-1.5 block font-mono text-[10.5px] uppercase tracking-widest text-ink-faint">
                                        Next
                                    </span>
                                    <span class="block text-[14.5px] font-semibold text-ink">
                                        {next.title}
                                        <span class="text-accent" aria-hidden="true">
                                            &nbsp;&#8594;
                                        </span>
                                    </span>
                                </a>
                            )}
                        </nav>
                    )
                }
            </article>
        </main>
    </div>
</Layout>

<script>
    const ACTIVATION_LINE = 81;

    class DocsToc extends HTMLElement {
        links = new Map<string, HTMLAnchorElement>();
        headings: HTMLElement[];
        frame = 0;

        constructor() {
            super();

            for (const a of this.querySelectorAll<HTMLAnchorElement>("[data-toc-link]")) {
                this.links.set(a.dataset.tocLink ?? "", a);
            }

            this.headings = Array.from(this.links.keys())
                .map((id) => document.getElementById(id))
                .filter((el) => el !== null);

            const schedule = () => {
                cancelAnimationFrame(this.frame);
                this.frame = requestAnimationFrame(() => this.update());
            };

            addEventListener("scroll", schedule, { passive: true });
            addEventListener("resize", schedule, { passive: true });

            this.update();
        }

        update() {
            if (this.headings.length === 0) {
                return;
            }

            const maxScroll = Math.max(document.documentElement.scrollHeight - innerHeight, 0);
            const remaining = Math.max(maxScroll - scrollY, 0);

            const slide = Math.min(innerHeight, maxScroll);
            const progress = slide > 0 ? 1 - Math.min(remaining, slide) / slide : 0;
            const line = ACTIVATION_LINE + (innerHeight - ACTIVATION_LINE) * progress;

            let current = this.headings[0];

            for (const heading of this.headings) {
                if (heading.getBoundingClientRect().top > line) {
                    break;
                }

                current = heading;
            }

            this.setCurrent(current?.id);
        }

        setCurrent(id: string | undefined) {
            for (const [slug, link] of this.links) {
                if (slug === id) {
                    link.setAttribute("aria-current", "true");
                } else {
                    link.removeAttribute("aria-current");
                }
            }
        }
    }

    customElements.define("docs-toc", DocsToc);
</script>

<style>
    .prose :global(p) {
        font-size: 16px;
        line-height: 1.7;
        color: var(--color-ink-muted);
        margin: 0 0 18px;
    }

    .prose :global(h2) {
        font-family: var(--font-display), serif;
        font-weight: 500;
        font-size: 27px;
        letter-spacing: -0.018em;
        margin: 42px 0 16px;
        scroll-margin-top: 80px;
    }

    .prose :global(h3) {
        font-family: var(--font-display), serif;
        font-weight: 500;
        font-size: 20px;
        margin: 32px 0 10px;
        scroll-margin-top: 80px;
    }

    .prose :global(a) {
        color: var(--color-quill);
        font-weight: inherit;
        text-decoration: none;
    }

    .prose :global(a:hover) {
        text-decoration: underline;
    }

    .prose :global(strong) {
        color: var(--color-ink);
        font-weight: 600;
    }

    .prose :global(ul),
    .prose :global(ol) {
        margin: 0 0 18px;
        padding-left: 22px;
    }

    .prose :global(li) {
        font-size: 16px;
        line-height: 1.7;
        color: var(--color-ink-muted);
        margin-bottom: 6px;
    }

    .prose :global(hr) {
        border: 0;
        border-top: 1px solid var(--color-hairline);
        margin: 34px 0;
    }

    .prose :global(blockquote) {
        margin: 20px 0;
        padding-left: 18px;
        border-left: 2px solid var(--color-hairline-strong);
        font-family: var(--font-display), serif;
        font-style: italic;
    }

    .prose :global(:not(pre) > code) {
        font-family: var(--font-mono), monospace;
        font-size: 0.86em;
        color: var(--color-quill);
        background: var(--color-canvas-raised);
        border: 1px solid var(--color-hairline);
        border-radius: 5px;
        padding: 2px 6px;
    }

    .prose :global(pre) {
        margin: 18px 0;
        padding: 16px 18px;
        border-radius: 11px;
        border: 1px solid var(--color-hairline);
        overflow-x: auto;
        font-size: 14px;
        line-height: 1.62;
    }

    .prose :global(pre code) {
        font-family: var(--font-mono), monospace;
    }

    .prose :global(table) {
        display: block;
        overflow-x: auto;
        border-collapse: collapse;
        margin: 20px 0 26px;
    }

    .prose :global(th) {
        font-family: var(--font-mono), monospace;
        font-size: 12px;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--color-ink-faint);
        text-align: left;
        padding: 0 22px 9px 0;
        border-bottom: 1px solid var(--color-hairline);
        white-space: nowrap;
    }

    .prose :global(td) {
        font-size: 15px;
        line-height: 1.6;
        color: var(--color-ink-muted);
        vertical-align: top;
        padding: 10px 22px 10px 0;
        border-bottom: 1px solid var(--color-hairline);
    }

    .prose :global(tr > *:last-child) {
        padding-right: 0;
    }
</style>
