---
import { Code } from "astro:components";
import { shiki } from "../../config/Code";

interface Props {
    label?: string;
    code: string;
    lang?: string;
}

const { label = "Terminal", code, lang = "sh" } = Astro.props;
---

<div class="code-block not-prose mb-5 mt-5 overflow-hidden rounded-[11px] border border-hairline">
    <div class="flex items-center justify-between border-b border-hairline bg-canvas-raised px-3.5 py-2">
        <span class="font-mono text-[11px] tracking-[0.04em] text-ink-faint">{label}</span>
        <button
            type="button"
            class="inline-flex cursor-pointer items-center rounded-md border border-hairline bg-transparent px-2.25 py-1 font-mono text-[11px] text-ink-muted transition hover:border-hairline-strong hover:text-ink"
            data-copy-text={code}>Copy</button
        >
    </div>
    <Code code={code} lang={lang} {...shiki} />
</div>

<style>
    :global(.code-block pre.astro-code) {
        margin: 0;
        padding: 14px 16px;
        overflow-x: auto;
        font-size: 14px;
        line-height: 1.6;
    }
</style>
