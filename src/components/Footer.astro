---
import Logo from "./Logo.astro";

const authorUrl = "https://github.com/jacobjoergensen";
const repoUrl = "https://github.com/jacobjoergensen/laravel-paper";
const licenseUrl = `${repoUrl}/blob/main/LICENSE.md`;

const columns = [
    {
        heading: "Docs",
        links: [
            { label: "Getting started", href: "/docs/getting-started" },
            { label: "Defining models", href: "/docs/defining-models" },
            { label: "Querying", href: "/docs/querying" },
            { label: "Writing", href: "/docs/writing" },
        ],
    },
    {
        heading: "Reference",
        links: [
            { label: "Relationships", href: "/docs/relationships" },
            { label: "Validation", href: "/docs/validation" },
            { label: "Custom drivers", href: "/docs/custom-drivers" },
            { label: "Changelog", href: "/docs/changelog" },
        ],
    },
    {
        heading: "Project",
        links: [
            { label: "GitHub", href: repoUrl },
            { label: "Packagist", href: "https://packagist.org/packages/jacobjoergensen/laravel-paper" },
            { label: "Issues", href: `${repoUrl}/issues` },
            { label: "Contributing", href: `${repoUrl}/blob/main/.github/CONTRIBUTING.md` },
        ],
    },
];
---

<footer class="mx-auto max-w-wide px-(--gutter) pb-11 pt-24">
    <div class="footer-grid grid grid-cols-[1.5fr_1fr_1fr_1fr] gap-10 border-t border-hairline pt-11 max-[860px]:grid-cols-2 max-[560px]:grid-cols-1">
        <div>
            <div class="mb-3 flex items-center gap-2.5">
                <Logo class="size-6 shrink-0" />
                <span class="font-mono text-sm font-semibold tracking-[-0.3px]">laravel-paper</span>
            </div>
            <p class="m-0 max-w-64 text-[13.5px] leading-[1.65] text-ink-muted">
                A flat-file Eloquent driver for modern Laravel. Markdown and JSON, on Laravel 12+
                and PHP 8.4+.
            </p>
        </div>

        {
            columns.map((col) => (
                <div>
                    <div class="mb-3.5 font-mono text-[10.5px] uppercase tracking-widest text-ink-faint">
                        {col.heading}
                    </div>
                    <ul class="m-0 flex list-none flex-col gap-2.5 p-0">
                        {col.links.map((l) => (
                            <li>
                                <a
                                    href={l.href}
                                    class="text-[13.5px] text-ink-muted no-underline transition-colors hover:text-ink"
                                >
                                    {l.label}
                                </a>
                            </li>
                        ))}
                    </ul>
                </div>
            ))
        }
    </div>

    <div class="mt-11 flex flex-wrap items-center justify-between gap-4 border-t border-hairline pt-6 font-mono text-[12.5px]">
        <span class="text-ink-muted">
            laravel-paper - <a
                href={licenseUrl}
                target="_blank"
                rel="noopener"
                class="text-ink-muted no-underline transition-colors hover:text-ink">MIT</a
            >
        </span>
        <span class="text-ink-faint">
            Created by&nbsp;<a
                href={authorUrl}
                target="_blank"
                rel="noopener"
                class="text-ink-muted no-underline transition-colors hover:text-ink"
                >Jacob Jørgensen</a
            >
        </span>
    </div>
</footer>
