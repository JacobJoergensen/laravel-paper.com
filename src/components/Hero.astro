---
import GitHubIcon from "./icons/GitHubIcon.astro";

const installCommand = "composer require jacobjoergensen/laravel-paper";
const repoUrl = "https://github.com/jacobjoergensen/laravel-paper";
---

<div class="relative animate-fade-up">
    <h1 class="mb-6 mt-0 max-w-[16ch] text-balance font-display text-[clamp(48px,8vw,86px)] font-medium leading-[0.98] tracking-[-0.03em]">
        Eloquent. <span class="italic text-accent">On paper.</span>
    </h1>

    <p class="mb-9 mt-0 max-w-[52ch] text-pretty text-[18.5px] leading-[1.6] text-ink-muted">
        Laravel Paper is a Laravel package that adds flat-file driver support for Eloquent. It
        supports Markdown and JSON files and works with Laravel 12+ on PHP 8.4+.
    </p>

    <div class="mb-7 flex flex-wrap gap-3">
        <a
            href="/docs/getting-started"
            class="inline-flex items-center gap-2 rounded-[9px] bg-accent px-6 py-3.25 text-[15px] font-semibold text-accent-ink no-underline shadow-[0_8px_22px_-12px_var(--color-accent)] transition hover:bg-accent-press active:translate-y-px"
        >
            Get started <span class="text-base">&rarr;</span>
        </a>
        <a
            href={repoUrl}
            class="inline-flex items-center gap-2.25 rounded-[9px] border border-hairline-strong px-5 py-3.25 text-[15px] font-medium text-ink no-underline transition hover:bg-canvas-raised"
        >
            <GitHubIcon size={16} /> GitHub
        </a>
    </div>

    <div class="flex w-fit max-w-full items-center gap-3 rounded-[9px] border border-hairline bg-canvas-raised px-3.5 py-3 font-mono text-[13px]">
        <span class="min-w-0 truncate text-ink">
            <span class="text-accent" aria-hidden="true">$</span>&nbsp;{installCommand}
        </span>
        <button
            type="button"
            class="inline-flex shrink-0 cursor-pointer items-center gap-1.25 rounded-md border border-hairline bg-transparent px-2.5 py-1.25 font-mono text-[11.5px] text-ink-muted transition hover:border-hairline-strong hover:text-ink"
            data-copy-text={installCommand}
        >
            Copy
        </button>
    </div>
</div>
