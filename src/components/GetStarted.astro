---
import { Code } from "astro:components";
import { shiki } from "../config/Code";
import { examples } from "../config/Examples";

const installCommand = "composer require jacobjoergensen/laravel-paper";

const pane = "flex min-w-0 flex-col overflow-hidden rounded-xl border border-hairline shadow-lift";

const paneHeader =
    "flex items-center justify-between gap-3 border-b border-hairline bg-canvas-raised px-4 py-2.5 font-mono text-[11.5px] text-ink-faint";

const step = "flex min-h-9.5 items-center gap-3";

const stepNumber =
    "grid size-6.5 shrink-0 place-items-center rounded-full border border-hairline-strong bg-canvas-raised font-mono text-[11.5px] text-accent";

const stepTitle = "m-0 font-display text-[19px] font-medium tracking-[-0.015em]";
---

<h2 class="mb-6 mt-0 font-display text-[clamp(28px,3.6vw,40px)] font-medium tracking-[-0.02em]">
    Get started
</h2>

<div class="flex flex-col gap-12">
    <div class="grid grid-cols-2 gap-4 max-[860px]:grid-cols-1">
        <div class="flex min-w-0 flex-col gap-4">
            <div class={step}>
                <span class={stepNumber}>1</span>
                <h3 class={stepTitle}>Install the package</h3>
            </div>

            <div class={pane}>
                <div class={paneHeader}>
                    <span>Terminal</span>
                </div>
                <div class="flex items-center gap-3 bg-canvas-sunken py-3 pl-4.5 pr-3">
                    <pre class="m-0 min-w-0 flex-1 overflow-x-auto font-mono text-[13px] leading-[1.62] text-ink"><span class="select-none text-accent" aria-hidden="true">$ </span>{installCommand}</pre>
                    <button
                        type="button"
                        class="shrink-0 cursor-pointer rounded-md border border-hairline bg-transparent px-2.25 py-1 font-mono text-[11px] text-ink-muted transition hover:border-hairline-strong hover:text-ink"
                        data-copy-text={installCommand}
                    >
                        Copy
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="flex flex-col gap-4">
        <div class="grid grid-cols-2 gap-4 max-[860px]:grid-cols-1">
            <div class="flex flex-col items-start gap-3">
                <div
                    class="flex gap-1 rounded-[9px] border border-hairline bg-canvas-raised p-1"
                    role="tablist"
                    aria-label="Content format"
                >
                    {
                        examples.map((ex, i) => (
                            <button
                                type="button"
                                role="tab"
                                id={`example-tab-${ex.id}`}
                                aria-controls={`example-panel-${ex.id}`}
                                aria-selected={i === 0 ? "true" : "false"}
                                class="cursor-pointer rounded-md border-0 bg-transparent px-3.5 py-1.5 font-mono text-[12.5px] text-ink-muted transition aria-selected:bg-accent aria-selected:text-accent-ink"
                            >
                                {ex.label}
                            </button>
                        ))
                    }
                </div>

                <div class={step}>
                    <span class={stepNumber}>2</span>
                    <h3 class={stepTitle}>Write a file</h3>
                </div>
            </div>

            <div class:list={[step, "self-end max-[860px]:hidden"]}>
                <span class={stepNumber}>3</span>
                <h3 class={stepTitle}>Query it with Eloquent</h3>
            </div>
        </div>

        <paper-tabs>
            {
                examples.map((ex, i) => (
                    <div
                        id={`example-panel-${ex.id}`}
                        role="tabpanel"
                        aria-labelledby={`example-tab-${ex.id}`}
                        hidden={i !== 0}
                        class="example-grid grid grid-cols-2 gap-4 max-[860px]:grid-cols-1"
                    >
                        <div class={pane}>
                            <div class={paneHeader}>
                                <span>{ex.file}</span>
                                <span>on disk</span>
                            </div>
                            <Code code={ex.content} lang={ex.lang} {...shiki} />
                        </div>

                        <div class="flex min-w-0 flex-col gap-4">
                            <div class:list={[step, "hidden pt-8 max-[860px]:flex"]}>
                                <span class={stepNumber}>3</span>
                                <h3 class={stepTitle}>Query it with Eloquent</h3>
                            </div>

                            <div class:list={[pane, "flex-1"]}>
                                <div class={paneHeader}>
                                    <span>{ex.codeFile}</span>
                                    <span class="text-accent">Eloquent</span>
                                </div>
                                <Code code={ex.code} lang="php" {...shiki} />
                            </div>
                        </div>
                    </div>
                ))
            }
        </paper-tabs>
    </div>
</div>

<style>
    :global(.example-grid pre.astro-code) {
        flex: 1;
        margin: 0;
        padding: 16px 18px;
        min-height: 260px;
        overflow-x: auto;
        font-size: 13px;
        line-height: 1.62;
    }
</style>

<script>
    class PaperTabs extends HTMLElement {
        panels = Array.from(this.querySelectorAll<HTMLElement>("[role=tabpanel]"));
        tabs = Array.from(document.querySelectorAll<HTMLButtonElement>("[role=tablist] [role=tab]"));

        constructor() {
            super();

            this.tabs.forEach((tab, i) => {
                tab.addEventListener("click", () => this.select(i));
            });
        }

        select(index: number) {
            this.tabs.forEach((tab, i) => {
                tab.setAttribute("aria-selected", String(i === index));
            });

            this.panels.forEach((panel, i) => {
                panel.hidden = i !== index;
            });
        }
    }

    customElements.define("paper-tabs", PaperTabs);
</script>
